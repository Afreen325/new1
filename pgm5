import unittest
from tracker import solve_two_sum

class TestDSASolutions(unittest.TestCase):

    def test_two_sum_standard(self):
        self.assertEqual(solve_two_sum([2, 7, 11, 15], 9), [0, 1])

    def test_two_sum_multiple_matches(self):
        self.assertEqual(solve_two_sum([3, 2, 4], 6), [1, 2])

    def test_two_sum_same_numbers(self):
        self.assertEqual(solve_two_sum([3, 3], 6), [0, 1])

    def test_two_sum_no_match(self):
        self.assertEqual(solve_two_sum([1, 2, 3], 7), [])

if __name__ == "__main__":
    unittest.main()
